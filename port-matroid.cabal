cabal-version:      2.4
name:               port-matroid
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:
      Snapshot.Types
      Snapshot.Errors
      Snapshot.Limits
      Snapshot.Decode
      Snapshot.Encode
      Snapshot.Reconcile.Types
      Snapshot.Reconcile.Core
      Snapshot.Universe.Types
      Snapshot.Universe.Core
      Snapshot.Scheduler.Types
      Snapshot.Scheduler.Decode
      Snapshot.Scheduler.Encode
      Snapshot.Scheduler.Validate
      Snapshot.Scheduler.Core
      Snapshot.Scheduler.Network.Types
      Snapshot.Scheduler.Network.Encode
      Snapshot.Scheduler.Network.Decode
      Snapshot.Scheduler.Network.Digest
      Snapshot.Scheduler.Network.Authority
      Snapshot.Scheduler.Network.Epoch
      Snapshot.Routing.Types
      Snapshot.Routing.Encode
      Snapshot.Routing.Decode
      Snapshot.Routing.Core
  hs-source-dirs:   src
  build-depends:
      base >=4.14 && <5,
      bytestring,
      containers,
      binary,
      cryptohash-sha256,
      text,
      transformers,
      unicode-transforms == 0.4.0.1
  default-language: Haskell2010

executable snapshot-verify
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      base,
      bytestring,
      port-matroid
  default-language: Haskell2010

test-suite golden
  type:             exitcode-stdio-1.0
  main-is:          GoldenSpec.hs
  hs-source-dirs:   test
  build-depends:
      base,
      port-matroid,
      bytestring,
      cryptohash-sha256
  default-language: Haskell2010

